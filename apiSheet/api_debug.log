                cd_dept.`desc` AS department,
                cd_role.`desc` AS role,
                u.email,
                COUNT(t.task_id) AS task_count,
                SUM(CASE WHEN t.status = 61 THEN 1 ELSE 0 END) AS completed_task_count
            FROM 
                users u
