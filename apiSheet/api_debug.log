            SELECT 
                u.id,
                CONCAT(u.f_name, ' ', u.l_name) AS user,
                cd_dept.`desc` AS department,
                cd_role.`desc` AS role,
                u.email,
                COUNT(t.task_id) AS task_count,
                SUM(CASE WHEN t.status = 61 THEN 1 ELSE 0 END) AS completed_task_count,
                COALESCE(
                    ROUND(
                        (
                            SELECT COUNT(*)
                            FROM tasks t2
                            JOIN projects p2 ON t2.project_id = p2.project_id
                            WHERE t2.assigned_to = u.id
                            AND t2.status = 61
                            AND p2.approved_date BETWEEN ? AND ?
                            AND t2.updated_at IS NOT NULL
                            AND t2.end_date IS NOT NULL
                            AND p2.approved_date IS NOT NULL
                            AND (
                                DATEDIFF(t2.updated_at, p2.approved_date) - 
                                (2 * FLOOR(DATEDIFF(t2.updated_at, p2.approved_date) / 7) + 
                                 LEAST(DATEDIFF(t2.updated_at, p2.approved_date) % 7, 
                                       1 + (DAYOFWEEK(p2.approved_date) + (DATEDIFF(t2.updated_at, p2.approved_date) % 7) - 1) % 7 IN (1, 7))
                                )
                            ) <= (
                                DATEDIFF(t2.end_date, p2.approved_date) - 
                                (2 * FLOOR(DATEDIFF(t2.end_date, p2.approved_date) / 7) + 
                                 LEAST(DATEDIFF(t2.end_date, p2.approved_date) % 7, 
                                       1 + (DAYOFWEEK(p2.approved_date) + (DATEDIFF(t2.end_date, p2.approved_date) % 7) - 1) % 7 IN (1, 7))
                                )
                            )
                        ) / NULLIF(COUNT(t.task_id), 0) * 100, 2
                    ), 0
                ) AS efficiency
            FROM 
                users u
            LEFT JOIN 
                code_desc cd_dept ON u.dept = cd_dept.id AND cd_dept.init = 'dpt'
            LEFT JOIN 
                code_desc cd_role ON u.role = cd_role.id AND cd_role.init = 'rol'
            LEFT JOIN 
                tasks t ON t.assigned_to = u.id 
            LEFT JOIN 
                projects p ON t.project_id = p.project_id 
                AND p.approved_date BETWEEN ? AND ?
            WHERE 
                u.is_active = 1
            GROUP BY 
                u.id, u.f_name, u.l_name, cd_dept.`desc`, cd_role.`desc`, u.email
            HAVING 
                COUNT(t.task_id) > 0
            ORDER BY 
                efficiency DESC, u.f_name, u.l_name with params start_date=2025-01-01, end_date=2025-07-02
